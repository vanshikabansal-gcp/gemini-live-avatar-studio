# Copy to .env and customize for your Google Cloud deployment
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
LIVE_MODEL=gemini-3.8-live-preview

# Optional: Google Cloud Storage bucket for persisting custom avatars across Cloud Run restarts
GCS_PERSIST_BUCKET=

# Optional: Protect the Studio UI behind an email domain + password gate
STUDIO_ACCESS_PASSWORD=
STUDIO_ALLOWED_DOMAINS=google.com
